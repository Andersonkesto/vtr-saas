PORT=3333

# Evolution API / Manager
EVOLUTION_URL=https://sua-evolution.exemplo.com
EVOLUTION_INSTANCE=sua-instancia
EVOLUTION_APIKEY=sua-chave

# Use um segredo próprio e configure a Evolution para chamar:
# https://seu-dominio.com/evolution/webhook?secret=este-segredo
WEBHOOK_SECRET=troque-este-segredo

# Firebase Admin SDK
# Opção 1: caminho para o JSON da conta de serviço
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Opção 2: credenciais por variáveis, útil em Docker/PM2 sem arquivo JSON
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
